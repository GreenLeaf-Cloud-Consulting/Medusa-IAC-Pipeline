# GitHub Authentication (pour cloner le repo privé)
# Créer un token: https://github.com/settings/tokens
# Scope requis: repo
GITHUB_ACCESS_TOKEN=ghp_your_token_here

# Medusa Security
MEDUSA_JWT_SECRET=your-super-secret-jwt-key-here
MEDUSA_COOKIE_SECRET=your-super-secret-cookie-key-here

# France Database Configuration
FRANCE_DATABASE_URL=postgres://medusa:password@france-db-host:5432/medusa
FRANCE_REDIS_URL=redis://france-redis-host:6379

# Germany Database Configuration
GERMANY_DATABASE_URL=postgres://medusa:password@germany-db-host:5432/medusa
GERMANY_REDIS_URL=redis://germany-redis-host:6379

# CORS Configuration
FRANCE_STORE_CORS=https://store.france.example.com
FRANCE_ADMIN_CORS=https://admin.france.example.com
GERMANY_STORE_CORS=https://store.germany.example.com
GERMANY_ADMIN_CORS=https://admin.germany.example.com

# AWS Configuration (optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-3