version: '3.8'

services:
  redis:
    image: redis:7-alpine
    container_name: medusa-redis
    restart: unless-stopped
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    command: redis-server --appendonly yes
    networks:
      - medusa-network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  medusa:
    build:
      context: {{ medusa_app_dir }}
      dockerfile: Dockerfile
    image: medusa-backend:latest
    container_name: medusa-backend
    restart: unless-stopped
    ports:
      - "{{ medusa_backend_port }}:{{ medusa_backend_port }}"
    env_file:
      - {{ medusa_app_dir }}/.env
    depends_on:
      redis:
        condition: service_healthy
    networks:
      - medusa-network
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:{{ medusa_backend_port }}/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 120s

volumes:
  redis_data:
    driver: local

networks:
  medusa-network:
    driver: bridge
