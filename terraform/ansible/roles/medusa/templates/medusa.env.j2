# Medusa Configuration
NODE_ENV={{ node_env | default('production') }}
PORT={{ medusa_backend_port | default(9000) }}

# Database Configuration
DATABASE_TYPE={{ database_type | default('postgres') }}
DATABASE_URL={{ database_url }}

# Redis Configuration
REDIS_URL={{ redis_url | default('redis://redis:6379') }}

# JWT Secret
JWT_SECRET={{ jwt_secret }}
COOKIE_SECRET={{ cookie_secret }}

# Store Configuration
STORE_CORS={{ store_cors | default('*') }}
ADMIN_CORS={{ admin_cors | default('*') }}
AUTH_CORS={{ admin_cors | default('*') }}

# Region Configuration
{% if is_primary_region | default(false) %}
PRIMARY_REPLICA=1
REPLICA_REPLICA=0
{% else %}
PRIMARY_REPLICA=0
REPLICA_REPLICA=1
{% endif %}

# AWS Configuration (if needed)
{% if aws_region is defined %}
AWS_REGION={{ aws_region }}
{% endif %}
{% if aws_access_key_id is defined %}
AWS_ACCESS_KEY_ID={{ aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ aws_secret_access_key }}
{% endif %}

# Additional environment variables
{% for key, value in additional_env_vars.items() %}
{{ key }}={{ value }}
{% endfor %}
