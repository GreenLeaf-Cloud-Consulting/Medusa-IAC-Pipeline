---
# ===========================================
# Ansible Inventory - Generated by Terraform
# Multi-Region Architecture with ALB
# ===========================================

all:
  vars:
    ansible_user: admin
    ansible_python_interpreter: /usr/bin/python3

    # Database configuration (dynamically generated)
    database_url: "postgres://medusa:medusa_secure_password_change_me@13.135.123.110:5432/medusa"

  children:
    # ========================================
    # FRANCE REGION
    # ========================================
    france:
      children:
        france_app:
          hosts:
            france-prod-app-1:
              ansible_host: 13.43.87.61
              private_ip: 172.31.34.181
              ansible_ssh_private_key_file: ../keys/prod-eu-west-2-app-1-key.pem
              env_name: prod
              region: france
              role: medusa-app

            france-prod-app-2:
              ansible_host: 18.132.250.40
              private_ip: 172.31.5.163
              ansible_ssh_private_key_file: ../keys/prod-eu-west-2-app-2-key.pem
              env_name: prod
              region: france
              role: medusa-app

        france_database:
          hosts:
            france-prod-db-primary:
              ansible_host: 13.135.123.110
              private_ip: 172.31.40.117
              ansible_ssh_private_key_file: ../keys/prod-france-db-key.pem
              env_name: prod
              region: france
              role: database-primary
              db_type: primary

            france-prod-db-replica-1:
              ansible_host: 35.179.169.175
              private_ip: 172.31.4.40
              ansible_ssh_private_key_file: ../keys/prod-france-replica-db-key.pem
              env_name: prod
              region: france
              role: database-replica
              db_type: replica
              primary_db_ip: 172.31.40.117


    # ========================================
    # GERMANY REGION
    # ========================================
    germany:
      children:
        germany_app:
          hosts:
            germany-prod-app-1:
              ansible_host: 3.72.80.153
              private_ip: 172.31.0.156
              ansible_ssh_private_key_file: ../keys/prod-eu-central-1-app-1-key.pem
              env_name: prod
              region: germany
              role: medusa-app

            germany-prod-app-2:
              ansible_host: 3.66.157.166
              private_ip: 172.31.47.64
              ansible_ssh_private_key_file: ../keys/prod-eu-central-1-app-2-key.pem
              env_name: prod
              region: germany
              role: medusa-app

        germany_database:
          hosts:
            germany-prod-db-replica-1:
              ansible_host: 3.79.203.32
              private_ip: 172.31.11.175
              ansible_ssh_private_key_file: ../keys/prod-germany-db-key.pem
              env_name: prod
              region: germany
              role: database-replica
              db_type: replica
              primary_db_ip: 13.135.123.110


    # ========================================
    # ROLE GROUPS
    # ========================================
    medusa_app:
      children:
        france_app:
        germany_app:

    databases:
      children:
        france_database:
        germany_database:

    database_primary:
      hosts:
        france-prod-db-primary:

    database_replicas:
      hosts:
        france-prod-db-replica-1:
        germany-prod-db-replica-1:
